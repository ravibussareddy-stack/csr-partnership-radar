# Copy to .env.local and fill in. Never commit real values.

# Postgres. Neon connection string in production / CI.
# For local runs without Neon, use an embedded PGlite file instead:
#   DATABASE_URL=pglite://./.pglite
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Gemini model id. Default reflects the "latest stable Flash" listed at
# https://ai.google.dev/gemini-api/docs/models on 2026-10-11. Change without a code edit.
GEMINI_MODEL=gemini-3.8-flash

# Gemini API keys. Primary is required for classification; fallbacks are optional
# and are only used when a key hits 429 / quota errors. Numbered 1..N, no gaps.
GEMINI_KEY_PRIMARY=
GEMINI_KEY_FALLBACK_1=
GEMINI_KEY_FALLBACK_2=

# Optional: cap Gemini calls per ingest run (protects free-tier quota).
MAX_CLASSIFY_PER_RUN=60

# Optional: intake inbox (IMAP, read-only) for Google Alerts, LinkedIn notification emails and
# forwarded messages. Use a dedicated Gmail account with 2-Step Verification and an app password.
INTAKE_IMAP_USER=
INTAKE_IMAP_PASSWORD=
INTAKE_MAILBOX=INBOX
# tagged (default): fetch only Google Alerts, LinkedIn and "[CSR-IN]" mail (safe for a personal inbox); all: whole mailbox
INTAKE_FILTER=tagged

# Optional: email delivery (Monday digest + instant Call alerts) via Gmail SMTP.
# Defaults to the INTAKE_IMAP_* account when NOTIFY_SMTP_* are empty.
NOTIFY_TO=
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=

# Web app (Vercel): the team lead's passcode (signs in as the lead; teammates get their own
# passcodes on the Team page), and optional secret for /api/revalidate
INTAKE_PASSCODE=
REVALIDATE_SECRET=
# Optional: display name for the lead (default Ananya) and a separate cookie-signing secret
LEAD_NAME=
SESSION_SECRET=
# Optional: answer questions / apply feedback right away instead of on the 10-minute schedule.
# A fine-grained GitHub token with "Actions: read and write" on this repo only, and "owner/repo".
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=
